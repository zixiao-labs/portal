{
  "name": "portal",
  "version": "1.0.0",
  "description": "Zixiao Laboratories portal",
  "private": true,
  "license": "SEE LICENSE IN License",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "nasti build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "smtp:check": "node --env-file-if-exists=.env scripts/check-smtp.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "format": "oxfmt src scripts tests nasti.config.ts lightning.config.ts",
    "test": "lightning run --project unit",
    "test:action": "python3 -B -m unittest discover -s tests/action -p '*_test.py'",
    "test:visual": "sh scripts/test-visual.sh"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@gravity-ui/icons": "^2.24.0",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@zixiao-labs/ui-kits-react": "^0.2.1",
    "jose": "^6.2.18",
    "nodemailer": "^8.0.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-parse": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sirv": "^3.0.2",
    "tailwindcss": "^4.3.5",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@lightning-js/lightning": "^3.2.1",
    "@nasti-toolchain/nasti": "^2.11.1",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/start-plugin-core": "1.171.55",
    "@types/node": "^26.6.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.95.0",
    "playwright": "1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2"
  }
}
