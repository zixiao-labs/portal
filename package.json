{
  "name": "portal",
  "version": "1.0.0",
  "description": "Zixiao Laboratories portal",
  "private": true,
  "license": "SEE LICENSE IN License",
  "packageManager": "pnpm@12.21.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "nasti build",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts tests",
    "format": "oxfmt src scripts tests nasti.config.ts lightning.config.ts",
    "test": "lightning run --project unit",
    "test:visual": "lightning run --project visual"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "dependencies": {
    "@gravity-ui/icons": "^2.23.1",
    "@tanstack/react-query": "^5.108.4",
    "@tanstack/react-query-devtools": "^5.108.4",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@zixiao-labs/ui-kits-react": "^0.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "jose": "^6",
    "nodemailer": "^8",
    "rehype-parse": "^9",
    "rehype-raw": "^7",
    "rehype-sanitize": "^6",
    "rehype-stringify": "^10",
    "remark-gfm": "^4",
    "remark-mdx": "^3",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "sirv": "^3",
    "unified": "^11"
  },
  "devDependencies": {
    "@lightning-js/lightning": "^3.1.4",
    "@nasti-toolchain/nasti": "^2.11.0",
    "@tanstack/router-generator": "1.167.46",
    "@tanstack/start-plugin-core": "1.171.55",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8",
    "@types/pngjs": "^6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "1.60.0",
    "pngjs": "^7",
    "typescript": "^7.0.2"
  }
}
