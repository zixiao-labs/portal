# 本地 pnpm dev；CI 生产部署固定为 https://zixiaolabs.com。
PORTAL_ORIGIN=http://localhost:3000
PORT=3000
BIND_HOST=127.0.0.1
SQLITE_PATH=data/portal.sqlite

# 生产：openssl rand -hex 32；切勿把实际值提交到 Git。
PORTAL_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub REST API 返回的 zixiao-labs 数字组织 ID（不是组织名或 App ID）。
GITHUB_ORG_ID=
# 后台管理员的工作邮箱，逗号分隔。首次需用工作邮箱验证码登录；留空禁用管理后台。
PORTAL_ADMIN_EMAILS=

# 本地不联调邮件时全部留空。阿里企业邮箱中国大陆站点：SMTP_HOST=smtp.qiye.aliyun.com
SMTP_HOST=
# 默认 implicit（465）；设为 starttls 时默认使用 587。
SMTP_TLS_MODE=
SMTP_PORT=
# 填原始邮箱和客户端安全密码，不需要 URL 编码；本地 .env 中含 # 等字符的值请按 dotenv 语法加引号。
SMTP_USER=
SMTP_PASSWORD=
# 地址留空时使用 SMTP_USER；显示名可选，单独填写。
SMTP_FROM=
SMTP_FROM_NAME=
