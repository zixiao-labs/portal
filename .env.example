# 本地 pnpm dev；生产 pnpm start 必须是 zixiaolabs.com 或其子域的 HTTPS URL。
PORTAL_ORIGIN=http://localhost:3000
PORT=3000
BIND_HOST=127.0.0.1
SQLITE_PATH=data/portal.sqlite

# 生产：openssl rand -hex 32；切勿把实际值提交到 Git。
PORTAL_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GitHub REST API 返回的 zixiao-labs 数字组织 ID（不是组织名或 App ID）。
GITHUB_ORG_ID=

# 阿里企业邮箱：中国大陆站点示例，隐式 TLS/465，不使用 25。
# 把实际邮箱与客户端专用密码分别做 URL 百分号编码；其他站点换其 SMTP 主机。
SMTP_URL=smtps://portal%40zixiaolabs.com:REPLACE_WITH_ENCODED_CLIENT_PASSWORD@smtp.qiye.aliyun.com:465
SMTP_FROM="紫霄实验室 <portal@zixiaolabs.com>"
